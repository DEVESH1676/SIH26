# MoSPI AI Learning Platform
# Example Configuration

# --- Application ---
APP_ENV=development
API_PORT=8001
DEBUG=True

# --- Database / Storage ---
CHROMA_DB_DIR=./chroma_db
SQLITE_DB_PATH=./data/learner_progress.db

# --- LLM Providers ---
# 1. Ollama (Local/Self-hosted)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-gpu:latest

# 2. Groq (Cloud - Faster fallback)
USE_GROQ=False
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# 3. Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
